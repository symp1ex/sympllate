        },
        {
          "id": "p1-b6-par1-l2",
          "text": "materials and cause a fire.",
          "box": { "x": 139, "y": 683, "width": 354, "height": 35 }
        },
        {
          "id": "p1-b6-par1-l3",
          "text": "Keep the area around the exhaust outlet",
          "box": { "x": 138, "y": 715, "width": 597, "height": 36 }
        },
        {
          "id": "p1-b6-par1-l4",
          "text": "clear. Locate the unit so that the exhaust",
          "box": { "x": 138, "y": 749, "width": 597, "height": 34 }
        },
        {
          "id": "p1-b6-par1-l5",
          "text": "outlet points toward an open area and is",
          "box": { "x": 138, "y": 783, "width": 597, "height": 35 }
        },
        {
          "id": "p1-b6-par1-l6",
          "text": "located at least one meter (3.3 feet) from any",
          "box": { "x": 136, "y": 815, "width": 598, "height": 38 }
        }
      ]
    },
